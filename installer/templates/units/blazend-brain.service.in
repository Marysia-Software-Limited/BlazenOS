[Unit]
Description=blazen_os brain (Python, assistant engine)
PartOf=blazend.target
After=blazend-nlu.service blazend-env.service
Wants=blazend-env.service

[Service]
Type=simple
@SERVICE_USER_BLOCK@
WorkingDirectory=@PY_ROOT@
Environment=PYTHONPATH=@PY_ROOT@
Environment=BLAZEN_RUNTIME_DIR=@RUNTIME_DIR@
Environment=BLAZEN_DATA_DIR=@DATA_DIR@
Environment=BLAZEN_MODELS_DIR=@MODELS_DIR@
Environment=BLAZEN_CONFIG_ROOT=@CONFIG_ROOT@
Environment=BLAZEN_MESH=@MESH_FILE@
Environment=BLAZEN_PROMPTS_DIR=@SITE_DIR@/prompts
@SYSTEMCTL_ENV@
EnvironmentFile=-@ENV_FILE@
EnvironmentFile=-@AUDIO_ENV_FILE@
EnvironmentFile=-@SECRETS_FILE@
ExecStart=@VENV_BIN@/python -m blazend.domains.ai_orchestrator.adapters.rpi5.brain
Restart=on-failure
RestartSec=3
TimeoutStartSec=60
@CPU_PINNING@

[Install]
WantedBy=blazend.target
