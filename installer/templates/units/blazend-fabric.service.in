[Unit]
Description=blazen_os fabric (Jessica multi-device federation, Rust)
PartOf=blazend.target
After=blazend-orchestrator.service network-online.target

[Service]
Type=simple
@SERVICE_USER_BLOCK@
Environment=BLAZEN_RUNTIME_DIR=@RUNTIME_DIR@
ExecStart=@BIN_DIR@/blazend-fabric
Restart=on-failure
RestartSec=3
@HARDENING_BLOCK@

[Install]
WantedBy=blazend.target
