# GENERATED by installer/install.sh — self-only mesh (no LAN peers; services
# are local or public internet, mirroring the appliance decision cc2883d).
version: 1
self: @NODE_NAME@
nodes:
  @NODE_NAME@:
    role: gpu
    host: 127.0.0.1
    resources:
      llm:
        ollama-11b:
          kind: openai
          url: http://127.0.0.1:11434
          model: bielik-11b
          unit: ollama.service
      asr:
        whisper-local:
          kind: faster-whisper
          local: true
          model: large-v3-turbo
      tts:
        piper-pl:
          local: true
      fabric:
        snapshot:
          kind: fabric
          url: http://127.0.0.1:7475/fabric/snapshot
