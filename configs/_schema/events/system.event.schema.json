{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://blazen.os/events/system.event",
  "title": "system.event",
  "type": "object",
  "required": ["v", "ts_ms", "source", "topic", "data"],
  "properties": {
    "v": { "type": "integer", "const": 1 },
    "ts_ms": { "type": "integer", "minimum": 0 },
    "source": { "type": "string", "minLength": 1 },
    "topic": { "type": "string", "const": "system.event" },
    "data": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "ready", "tick", "heartbeat", "observed",
            "sleep", "resume", "reboot_requested", "shutdown_requested",
            "recovery_entered", "recovery_exited"
          ]
        },
        "detail": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
