{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://blazen.os/events/audio.frame",
  "title": "audio.frame",
  "description": "Metadata about a raw PCM frame; the frame samples themselves live in the shared-memory ring buffer.",
  "type": "object",
  "required": ["v", "ts_ms", "source", "topic", "data"],
  "properties": {
    "v": { "type": "integer", "const": 1 },
    "ts_ms": { "type": "integer", "minimum": 0 },
    "source": { "type": "string", "minLength": 1 },
    "topic": { "type": "string", "const": "audio.frame" },
    "data": {
      "type": "object",
      "required": ["offset", "samples", "sample_rate_hz", "channels"],
      "properties": {
        "offset": { "type": "integer", "minimum": 0 },
        "samples": { "type": "integer", "minimum": 1 },
        "sample_rate_hz": { "type": "integer", "minimum": 8000 },
        "channels": { "type": "integer", "minimum": 1, "maximum": 8 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
