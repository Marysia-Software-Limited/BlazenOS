{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://blazen.os/events/brain.request",
  "title": "brain.request",
  "type": "object",
  "required": ["v", "ts_ms", "source", "topic", "data"],
  "properties": {
    "v": { "type": "integer", "const": 1 },
    "ts_ms": { "type": "integer", "minimum": 0 },
    "source": { "type": "string", "minLength": 1 },
    "topic": { "type": "string", "const": "brain.request" },
    "data": {
      "type": "object",
      "required": ["request_id", "language", "prompt"],
      "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "enum": ["en", "pl"] },
        "prompt": { "type": "string" },
        "system": { "type": "string" },
        "backend": {
          "type": "string",
          "enum": ["local", "ollama", "openai", "gemini"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
