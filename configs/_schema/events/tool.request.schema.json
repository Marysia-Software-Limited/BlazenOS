{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://blazen.os/events/tool.request",
  "title": "tool.request",
  "type": "object",
  "required": ["v", "ts_ms", "source", "topic", "data"],
  "properties": {
    "v": { "type": "integer", "const": 1 },
    "ts_ms": { "type": "integer", "minimum": 0 },
    "source": { "type": "string", "minLength": 1 },
    "topic": { "type": "string", "const": "tool.request" },
    "data": {
      "type": "object",
      "required": ["request_id", "tool", "language"],
      "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "tool": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "weather.query", "news.brief", "web.lookup",
            "radio.play", "radio.stop", "context.recall"
          ]
        },
        "language": { "type": "string", "enum": ["en", "pl"] },
        "args": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
