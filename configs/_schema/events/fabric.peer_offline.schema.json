{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://blazen.os/events/fabric.peer_offline",
  "title": "fabric.peer_offline",
  "type": "object",
  "required": ["v", "ts_ms", "source", "topic", "data"],
  "properties": {
    "v": { "type": "integer", "const": 1 },
    "ts_ms": { "type": "integer", "minimum": 0 },
    "source": { "type": "string", "minLength": 1 },
    "topic": { "type": "string", "const": "fabric.peer_offline" },
    "data": {
      "type": "object",
      "required": ["peer_id", "reason"],
      "properties": {
        "peer_id": { "type": "string", "minLength": 1 },
        "reason": {
          "type": "string",
          "enum": ["timeout", "kicked", "graceful_leave", "key_revoked"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
