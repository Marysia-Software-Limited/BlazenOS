{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://blazen.os/events/asr.final",
  "title": "asr.final",
  "type": "object",
  "required": ["v", "ts_ms", "source", "topic", "data"],
  "properties": {
    "v": { "type": "integer", "const": 1 },
    "ts_ms": { "type": "integer", "minimum": 0 },
    "source": { "type": "string", "minLength": 1 },
    "topic": { "type": "string", "const": "asr.final" },
    "data": {
      "type": "object",
      "required": ["language", "text", "confidence"],
      "properties": {
        "language": { "type": "string", "enum": ["en", "pl"] },
        "text": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "speaker_sim": {
          "type": "number", "minimum": -1, "maximum": 1,
          "description": "Speaker-ID cosine vs the owner profile (2026-09-08); absent = cannot tell (no model/profile) — treat as the owner."
        },
        "speaker_owner": {
          "type": "boolean",
          "description": "speaker_sim >= the site threshold; absent = trust the voice."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
