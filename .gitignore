# Build / run artifacts
vm-images/
# build/ holds the pi-gen clone + its multi-GB work/ and deploy/ trees
build/
dist/
*.qcow2
*.img
*.iso

# Models (large; reproducible via `make models`)
models/

# Generated audio fixtures (regen via `make audio-fixtures`)
rpi5/tests/fixtures/audio/
!rpi5/tests/fixtures/audio/.gitkeep

# Scratch / test projects
_test_projects/

# Python
.venv/
# .venv-train: py3.12 uv venv for wake-word training (openwakeword/onnx/piper)
# .venv-whisper: GPU whisper server venv (scripts/whisper_server.py)
.venv-train/
.venv-whisper/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Rust
target/
**/*.rs.bk
# Lockfiles are not tracked — Cargo regenerates them deterministically from the
# committed Cargo.toml manifests; keeping them out of git avoids cross-node churn.
*.lock
Cargo.lock.bak
.cargo/.package-cache

# Android (mobile twin)
android/.gradle/
android/build/
android/app/build/
android/core/build/
android/local.properties
android/**/*.iml
android/captures/
android/.kotlin/
android/app/release/*.apk
android/app/release/*.aab

# iOS (mobile twin)
ios/Jessica.xcodeproj/
ios/build/
ios/DerivedData/
ios/.build/
ios/.swiftpm/
ios/Package.resolved
ios/JessicaCore/.build/
ios/JessicaCore/.swiftpm/
ios/**/*.xcuserstate
ios/**/xcuserdata/
ios/**/*.p12
ios/**/*.mobileprovision

# Generated code from IPC schemas (regenerate via `make gen-events`)
domains/blazend-ipc/src/events/_generated.rs
rpi5/src/blazend/events/_generated.py

# Editor / OS
.idea/
.vscode/
.DS_Store
*.swp
*.swo

# Secrets / local-only configs
.env
.env.local
configs/**/secrets.yaml
ssh-keys/

# Logs
*.log
logs/

# Soak run output
soak-runs/

# Dev/VM/voice run output (logs, captured wavs, jessica-data)
vm-runs/

# Setuptools generated metadata (regenerated by pip install -e)
*.egg-info/

# Build artifacts / large local scratch (never committed)
# .docker-target = cross/Docker build output; wheelhouse = pip wheel cache;
# _unbaked-llm-stash = local LLM weights (multi-GB); claude_resume.txt = scratch.
.docker-target/
wheelhouse/
_unbaked-llm-stash/
claude_resume.txt
.venv-rachel/
