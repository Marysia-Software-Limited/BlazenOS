[Unit]
Description=blazen_os wake-word detector (Rust)
PartOf=blazend.target
After=blazend-audio-in.service
Requires=blazend-audio-in.service

[Service]
Type=simple
User=blazen
Group=blazen
Environment=BLAZEN_RUNTIME_DIR=/run/blazen
# Resolve the relative model defaults (models/wake/*.onnx) against the baked
# model tree, and point the `ort` crate at the onnxruntime shared lib the venv
# ships (without it the crate aborts on startup instead of falling back).
WorkingDirectory=/var/lib/blazen
Environment=ORT_DYLIB_PATH=/usr/lib/blazen/.venv/lib/python3.13/site-packages/onnxruntime/capi/libonnxruntime.so.1.27.0
# cooldown 3000ms collapses one spoken "dżesika" to a single wake and limits the
# re-fire rate across the rolling detection window (excess wakes flood the ASR
# fixed-window capture). threshold 0.7: close "dżesika" scores ~0.8-0.99, real
# commands/rhymes <=0.36, so 0.7 has wide margin. NOTE: clap flag is --cooldown-ms
# (hyphen), not _ms. Live capture LEVEL (Jabra DSP) is the limiter, not the score.
ExecStart=/usr/lib/blazen/bin/blazend-wake --threshold 0.8 --cooldown-ms 3000
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/blazen
ProtectHome=yes

[Install]
WantedBy=blazend.target
