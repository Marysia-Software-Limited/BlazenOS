[Unit]
Description=blazen_os HAT push-to-talk button watcher (GPIO17 → activate)
PartOf=blazend.target
After=blazend-audio-in.service

[Service]
Type=simple
User=blazen
Group=blazen
Environment=PYTHONPATH=/usr/lib/blazen
Environment=BLAZEN_RUNTIME_DIR=/run/blazen
# gpiomon needs the gpio character device; blazen is in the gpio group.
SupplementaryGroups=gpio
ExecStart=/usr/lib/blazen/.venv/bin/python -m blazend.domains.voice_input.adapters.rpi5.button
Restart=on-failure
RestartSec=2
# Pin off the real-time capture core (CPU0), like the other helpers. The button
# spends its life blocked in gpiomon, so this is essentially free.
AllowedCPUs=1-3
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/blazen
ProtectHome=yes

[Install]
WantedBy=blazend.target
