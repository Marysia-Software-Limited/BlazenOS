[Unit]
Description=blazen_os audio capture (Rust)
PartOf=blazend.target
After=sound.target

[Service]
Type=simple
User=blazen
Group=blazen
Environment=BLAZEN_RUNTIME_DIR=/run/blazen
# Jabra SPEAK 410 USB capture, measured on real hardware:
#  --device plughw:CARD=USB,DEV=0   the Jabra mic (USB-audio-class; clean onboard
#                      NR — no blazen-hat-mixer +30 dB hack). Card id "USB".
#  --hp-cutoff 180     2nd-order high-pass to kill 50 Hz mains hum.
#  --open/--close 2000/1000 (mult 1.0)  fixed thresholds: the Jabra's resting floor
#                      is ~120 RMS and near-field speech ~14-18k — a huge clean gap,
#                      so the thresholds sit far above the floor and far below speech.
#                      Re-measure with scripts/jabra-voice-check.py if the room changes.
#  --max-speech-ms 6000  force-close cap so a noisy stretch can't hold an utterance
#                      open forever and starve ASR of segments.
# Empirically tuned on the Jabra (2026-06-30): --hp-cutoff 0 keeps full-spectrum
# audio for ASR (the 180Hz HP stripped Polish vowel fundamentals and whisper
# misread it); resting floor ~30 RMS, conversational speech low, so open 80 /
# close 50 (close < open for hysteresis; the shipped 2000/1000 never opened).
# max-speech 1500 caps a segment to ~command length. NOTE: mic SNR is the open
# blocker — far-field voice (~-30 to -50 dBFS) is too quiet for whisper-small;
# speak near the mic or use a larger ASR model.
ExecStart=/usr/lib/blazen/bin/blazend-audio-in --device plughw:CARD=USB,DEV=0 --hp-cutoff 0 --open-rms 80 --open-mult 1.0 --close-rms 50 --close-mult 1.0 --hangover-ms 400 --min-speech-ms 150 --max-speech-ms 1500
Restart=on-failure
RestartSec=2
SupplementaryGroups=audio
# Real-time capture on a DEDICATED core. Without this, when ASR (ctranslate2)
# and Bielik (llama.cpp) saturate the 4 cores the capture thread xruns and the
# mic noise floor spikes from ~5k into the ~20k speech band — no VAD threshold
# can separate speech from that. FIFO priority + pinning CPU0 to capture (and
# the heavy services to CPU1-3, see their units) keeps the floor stable.
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=80
Nice=-15
AllowedCPUs=0
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/blazen
ProtectHome=yes

[Install]
WantedBy=blazend.target
