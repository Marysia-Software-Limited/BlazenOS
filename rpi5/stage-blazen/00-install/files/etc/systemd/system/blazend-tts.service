[Unit]
Description=blazen_os TTS (Rust, Piper)
PartOf=blazend.target
After=blazend-brain.service

[Service]
Type=simple
User=blazen
Group=blazen
Environment=BLAZEN_RUNTIME_DIR=/run/blazen
# Resolve the relative voice defaults (models/tts/*.onnx) against the baked
# model tree, and put the venv's `piper` CLI on PATH (the unit defaults to the
# bare name `piper`, which otherwise isn't found → synth fails with ENOENT).
WorkingDirectory=/var/lib/blazen
Environment=PATH=/usr/lib/blazen/.venv/bin:/usr/local/bin:/usr/bin:/bin
# Voice resolver: pre-rendered XTTS phrases in the local voice cache (offline,
# instant, Ana Florence) → live XTTS → Piper (pl_PL-gosia-medium, always-local
# Polish floor). Decision 2026-07-13 (node-local processing): live XTTS is OFF —
# empty URL skips only that branch, so novel replies render locally via Piper
# and cached phrases keep Ana. Restore the URL to re-enable paul's GPU voice:
#   Environment=BLAZEN_TTS_XTTS_URL=http://192.168.50.102:8091/synthesize
Environment=BLAZEN_TTS_XTTS_URL=
# --ring-seconds 300: the ring must hold ONE FULL reply. At 15 s a 16.7 s
# audiobook list wrapped and cut its own first ~2 s; at 40 s the web-research
# briefs (60-90 s of Piper audio) did the same (2026-08-21, "first seconds of
# the voice is cut"). The detailed news brief (4-5 items x 3 sections with
# specifics, user request 2026-08-21) can run 2-4 minutes, so 300 s — ~13 MB
# shm, still nothing on a 8/16 GB box.
ExecStart=/usr/lib/blazen/bin/blazend-tts --voice-cache /var/lib/blazen/voice-cache --ring-seconds 300
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
# voice-cache must be writable or the XTTS self-warming cache writes fail
# SILENTLY — every repeated phrase re-renders over the network forever and a
# one-off bad render can't be replaced by a better one.
ReadWritePaths=/run/blazen /var/lib/blazen/voice-cache
ProtectHome=yes

[Install]
WantedBy=blazend.target
