[Unit]
Description=blazen_os pipeline orchestrator (Python)
PartOf=blazend.target
# NOTE: blazend-wake is not listed in `Wants=` here — it is enabled in its own
# right (see the enable list in 00-install/01-run-chroot.sh) with a trained
# "dżesika" model (models/wake/jessica.onnx, threshold 0.8) and joins via
# blazend.target; duplicating it here would only double the dependency edges.
After=blazend-health.service blazend-audio-in.service
Wants=blazend-health.service blazend-audio-in.service \
      blazend-asr.service blazend-brain.service blazend-tts.service \
      blazend-audio-out.service

[Service]
Type=simple
User=blazen
Group=blazen
WorkingDirectory=/usr/lib/blazen
Environment=PYTHONPATH=/usr/lib/blazen
Environment=BLAZEN_RUNTIME_DIR=/run/blazen
# Persistent memory store (shared with brain — see blazend-brain.service).
Environment=BLAZEN_DATA_DIR=/var/lib/blazen/data
# Cloud opt-in keys (OpenAI for live news, etc.) — the fast-path tool dispatcher
# runs here, so it needs the same secrets the brain gets. Missing file is fine (-).
EnvironmentFile=-/etc/blazen/secrets.env
# Status LED: a single WS2812/NeoPixel on SPI0 MOSI (BCM10) shows Jessica's state
# (blue=listening, magenta=thinking, blue=speaking, red=error, off=idle). Fail-
# soft — no LED wired or SPI off → led.json stays the only status surface.
# Override BLAZEN_LED_TYPE=apa102 for the legacy HAT chain, or =none to disable.
Environment=BLAZEN_LED_TYPE=ws2812
# Single WS2812 on the Jabra appliance (docs/02-HARDWARE.md); the legacy
# ReSpeaker HAT chain had 3 APA102s — set 3 + BLAZEN_LED_TYPE=apa102 for that.
Environment=BLAZEN_LED_COUNT=1
ExecStart=/usr/lib/blazen/.venv/bin/python -m blazend.domains.systems.adapters.rpi5.orchestrator
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

# Hardening. NoNewPrivileges + RestrictSUIDSGID are intentionally OFF: the radio
# HAT hand-off shells out to `sudo systemctl start/stop blazend-audio-out`
# (single ALSA playback channel — see orchestrator/radio_control.py), allowed by
# the narrow /etc/sudoers.d/blazen-audio-out rule. sudo is setuid, so it needs
# both. The rest of the sandbox stays.
NoNewPrivileges=no
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/run/blazen /var/lib/blazen
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=no
RestrictNamespaces=yes
LockPersonality=yes
# llama.cpp JIT path needs this off
MemoryDenyWriteExecute=no
SystemCallFilter=@system-service

[Install]
WantedBy=blazend.target
