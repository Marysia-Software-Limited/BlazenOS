[Unit]
Description=blazen_os LLM (Python, llama-cpp-python / HailoRT)
PartOf=blazend.target
After=blazend-asr.service

[Service]
Type=simple
User=blazen
Group=blazen
WorkingDirectory=/usr/lib/blazen
Environment=PYTHONPATH=/usr/lib/blazen
Environment=BLAZEN_RUNTIME_DIR=/run/blazen
# Persistent memory (notes / voice memos / reminders / profile + embedding
# sidecar). Without this the store defaults under BLAZEN_RUNTIME_DIR —
# tmpfs — and every memory would vanish on reboot. Same tree in the asr and
# orchestrator units: all three processes share one memory.json.
Environment=BLAZEN_DATA_DIR=/var/lib/blazen/data
# Baked model tree. Without this, localllm.models_root() falls back to
# <pkg>/../../../../models = /usr/models (nonexistent), so resolve_model_path
# can't find the Bielik GGUF and the brain silently degrades to the canned
# "set GEMINI_API_KEY / a local model" reply. Points at the real bake location
# (same tree the embeddings + memory vector store use).
Environment=BLAZEN_MODELS_DIR=/var/lib/blazen/models
# GPU acceleration: the remote Ollama Bielik 11B endpoint (paul, RTX 3090) is now
# resolved from the mesh registry (paul.llm.ollama-11b in mesh.yaml) — no hardcoded
# peer IP here. Point the loader at the deployed registry; the registry falls back
# to the baked local Bielik (4.5B/1.5B GGUF) when paul is unreachable, so it's safe
# to ship. To override the endpoint manually, set BLAZEN_LLM_OLLAMA_URL.
# Site mesh, not repo defaults — the defaults mesh lists paul's Ollama/XTTS;
# the site file ships self-only (cc2883d) so nothing can route to LAN peers.
Environment=BLAZEN_MESH=/etc/blazen/mesh.yaml
Environment=BLAZEN_LLM_OLLAMA_MODEL=SpeakLeash/bielik-11b-v2.3-instruct:Q8_0
# Cloud DOUBT fallback: when a key is present the engine PREFERS OpenAI (gpt-5.5)
# for unclear/freeform requests, degrading to the local Bielik on any failure.
# The key is NOT in git — drop OPENAI_API_KEY=sk-… (or CHAT_GPT_KEY=…) into
# /etc/blazen/secrets.env (0600). With no key the path stays fully on-device.
# Model for the OPEN_QA / complex-question path (router backend `gpt-5.5`).
# gpt-4o is a real, capable model; override here to prefer another.
Environment=OPENAI_MODEL=gpt-4o
EnvironmentFile=-/etc/blazen/secrets.env
ExecStart=/usr/lib/blazen/.venv/bin/python -m blazend.domains.ai_orchestrator.adapters.rpi5.brain
Restart=on-failure
RestartSec=3
# model warm-up
TimeoutStartSec=60
# Bielik (llama.cpp) is the heaviest CPU consumer — keep it off the real-time
# capture core (CPU0); it shares CPU1-3 with ASR + nlu.
AllowedCPUs=1-3
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/blazen /var/lib/blazen
ProtectHome=yes

[Install]
WantedBy=blazend.target
