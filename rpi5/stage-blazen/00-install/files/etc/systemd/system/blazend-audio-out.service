[Unit]
Description=blazen_os speaker playback (Rust)
PartOf=blazend.target
After=sound.target

[Service]
Type=simple
User=blazen
Group=blazen
Environment=BLAZEN_RUNTIME_DIR=/run/blazen
# --device is a case-insensitive substring of the cpal output name. The Jabra
# SPEAK 410 speakerphone enumerates as CARD=USB, so `USB` selects it (mic + speaker
# are the same device); falls back to the default sink if the Jabra is absent.
ExecStart=/usr/lib/blazen/bin/blazend-audio-out --device USB
Restart=on-failure
RestartSec=2
SupplementaryGroups=audio
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/blazen
ProtectHome=yes

[Install]
WantedBy=blazend.target
