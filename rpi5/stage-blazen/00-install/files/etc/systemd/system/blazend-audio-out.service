[Unit]
Description=blazen_os speaker playback (Rust)
PartOf=blazend.target
After=sound.target

[Service]
Type=simple
User=blazen
Group=blazen
Environment=BLAZEN_RUNTIME_DIR=/run/blazen
ExecStart=/usr/lib/blazen/bin/blazend-audio-out
Restart=on-failure
RestartSec=2
SupplementaryGroups=audio
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/blazen
ProtectHome=yes

[Install]
WantedBy=blazend.target
