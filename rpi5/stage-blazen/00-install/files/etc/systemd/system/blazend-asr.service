[Unit]
Description=blazen_os ASR (Python, faster-whisper)
PartOf=blazend.target
After=blazend-audio-in.service
Requires=blazend-audio-in.service
# PartOf audio-in so restarting audio-in (which recreates the input ring) also
# restarts ASR → it re-attaches, instead of reading a stale/dead ring handle.
PartOf=blazend-audio-in.service

[Service]
Type=simple
User=blazen
Group=blazen
WorkingDirectory=/usr/lib/blazen
Environment=PYTHONPATH=/usr/lib/blazen
Environment=BLAZEN_RUNTIME_DIR=/run/blazen
# Persistent memory store (shared with brain — see blazend-brain.service).
Environment=BLAZEN_DATA_DIR=/var/lib/blazen/data
Environment=BLAZEN_MODELS_DIR=/var/lib/blazen/models
# faster-whisper loads the BAKED CT2 model under /var/lib/blazen/models/asr/
# (engine.py resolves the name → local dir). HF_HUB_OFFLINE makes any stray Hub
# lookup fail fast instead of hanging on the network / the ProtectHome sandbox
# (~/.cache/huggingface is unreadable here). OMP cap leaves headroom for Bielik.
Environment=HF_HUB_OFFLINE=1
Environment=OMP_NUM_THREADS=2
# Mesh MUST be the site file, not the repo defaults: the defaults mesh lists
# paul's GPU whisper-remote, and engine.py gives mesh discovery priority over
# the empty asr.yaml remote_url — with the defaults path every utterance tried
# paul's :8090 first (silent GPU offload on LAN; a timeout penalty per command
# once the appliance went GSM-only, caught 2026-08-21). The site mesh ships
# self-only (cc2883d). Override manually with BLAZEN_ASR_REMOTE_URL.
Environment=BLAZEN_MESH=/etc/blazen/mesh.yaml
ExecStart=/usr/lib/blazen/.venv/bin/python -m blazend.domains.voice_input.adapters.rpi5.asr
Restart=on-failure
RestartSec=3
# Keep heavy transcription OFF the capture core (CPU0 is reserved for real-time
# audio-in). nlu + Bielik are pinned to 1-3 too.
AllowedCPUs=1-3
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/blazen /var/lib/blazen
ProtectHome=yes

[Install]
WantedBy=blazend.target
