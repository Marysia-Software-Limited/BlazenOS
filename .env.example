# Copy to .env and fill in. Never commit .env.

# ---- Image build ----
BLAZEN_IMAGE_NAME=blazen_os
BLAZEN_IMAGE_VERSION=0.0.1-dev

# ---- Default user (for first-boot account; voice setup overrides later) ----
BLAZEN_DEFAULT_USER=blazen
BLAZEN_DEFAULT_PASSWORD=                  # if empty, a random one is generated and printed once
BLAZEN_AUTHORIZED_SSH_KEY=                # paste your ssh-ed25519 pubkey here

# ---- WiFi (for headless first boot; can be replaced by `voice: connect wifi`) ----
BLAZEN_WIFI_SSID=
BLAZEN_WIFI_PSK=
BLAZEN_WIFI_COUNTRY=PL

# ---- Model selection (overrides configs/*.yaml if set) ----
BLAZEN_ASR_MODEL=medium                   # tiny.en | base.en | small.en | small | medium | large-v3-turbo
BLAZEN_LLM_MODEL=qwen2.5-3b-instruct-q4_k_m
BLAZEN_TTS_VOICE_EN=en_US-lessac-medium
BLAZEN_TTS_VOICE_PL=pl_PL-darkman-medium
BLAZEN_WAKE_WORDS=hey_blazen_en,hey_blazen_pl

# ---- Rust toolchain (cross-build for Pi 5) ----
BLAZEN_RUST_TARGET=aarch64-unknown-linux-gnu
BLAZEN_RUST_PROFILE=release                # dev | release | release-with-debug

# ---- QEMU / VM testing ----
BLAZEN_QEMU_MACHINE=raspi4b                # raspi3b | raspi4b | virt (raspi5b upstream pending)
BLAZEN_QEMU_RAM_MB=8192                    # QEMU tops out below 16 GB cleanly; 8 GB profile is fine
BLAZEN_QEMU_CPUS=4
BLAZEN_QEMU_SSH_PORT=2222

# ---- Cloud assistant (Gemini) — for news / web lookups + freeform chat ----
# Get a key at https://aistudio.google.com/apikey. The assistant prototype
# (`make demo`) and the cloud-routing path activate when this is set; left
# empty, everything else still works offline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Telemetry (OFF by default) ----
BLAZEN_TELEMETRY=disabled                  # disabled | local-only | opt-in-cloud
